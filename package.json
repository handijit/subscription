{
  "name": "@handijit/subscription",
  "version": "1.1.0",
  "description": "Licensing and subscriptions for Han Dijit desktop programs on Electron: a device-bound free trial, a monthly or yearly subscription bound to one device, Ed25519 license verification in the main process, offline use until the license expires, a purchase flow through the web panel, a typed IPC fragment, a renderer client, a React hook and a paywall on @handijit/ui.",
  "author": "Ahmet ilhan <ahmetilhan.dev@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/handijit/subscription.git"
  },
  "homepage": "https://github.com/handijit/subscription#readme",
  "bugs": {
    "url": "https://github.com/handijit/subscription/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "main": "./build/index.cjs",
  "module": "./build/index.mjs",
  "types": "./build/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.ts",
        "default": "./build/index.cjs"
      },
      "default": "./build/index.mjs"
    },
    "./main": {
      "import": {
        "types": "./build/main.d.mts",
        "default": "./build/main.mjs"
      },
      "require": {
        "types": "./build/main.d.ts",
        "default": "./build/main.cjs"
      },
      "default": "./build/main.mjs"
    },
    "./preload": {
      "import": {
        "types": "./build/preload.d.mts",
        "default": "./build/preload.mjs"
      },
      "require": {
        "types": "./build/preload.d.ts",
        "default": "./build/preload.cjs"
      },
      "default": "./build/preload.mjs"
    },
    "./renderer": {
      "import": {
        "types": "./build/renderer.d.mts",
        "default": "./build/renderer.mjs"
      },
      "require": {
        "types": "./build/renderer.d.ts",
        "default": "./build/renderer.cjs"
      },
      "default": "./build/renderer.mjs"
    },
    "./react": {
      "import": {
        "types": "./build/react.d.mts",
        "default": "./build/react.mjs"
      },
      "require": {
        "types": "./build/react.d.ts",
        "default": "./build/react.cjs"
      },
      "default": "./build/react.mjs"
    },
    "./ui": {
      "import": {
        "types": "./build/ui.d.mts",
        "default": "./build/ui.mjs"
      },
      "require": {
        "types": "./build/ui.d.ts",
        "default": "./build/ui.cjs"
      },
      "default": "./build/ui.mjs"
    },
    "./styles.css": "./build/styles.css",
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "main": [
        "./build/main.d.ts"
      ],
      "preload": [
        "./build/preload.d.ts"
      ],
      "renderer": [
        "./build/renderer.d.ts"
      ],
      "react": [
        "./build/react.d.ts"
      ],
      "ui": [
        "./build/ui.d.ts"
      ]
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "build",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "sh ./scripts/prod-build.sh",
    "dev": "sh ./scripts/dev-build.sh",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run --coverage",
    "size": "node ./scripts/report-size.mjs",
    "lint:package": "publint && attw --pack . --exclude-entrypoints styles.css",
    "test:electron": "node ./scripts/electron-smoke.mjs",
    "screenshots": "node ./scripts/screenshots.mjs",
    "verify": "npm run lint && npm run typecheck && npm run test && npm run build && npm run size && npm run lint:package",
    "prepublishOnly": "npm run verify"
  },
  "keywords": [
    "electron",
    "subscription",
    "license",
    "licensing",
    "trial",
    "paywall",
    "ed25519",
    "offline",
    "ipc",
    "react",
    "handijit"
  ],
  "private": false,
  "peerDependencies": {
    "@handijit/auth": "^1.0.0",
    "@handijit/core": "^1.1.0",
    "@handijit/electron": "^1.0.0",
    "@handijit/ui": "^2.0.0",
    "electron": ">=43.0.0 <46.0.0",
    "react": ">=18",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "@handijit/ui": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.5",
    "@eslint/js": "^10.0.1",
    "@handijit/auth": "^1.0.0",
    "@handijit/core": "^1.1.0",
    "@handijit/design": "^1.1.0",
    "@handijit/electron": "^1.0.0",
    "@handijit/ui": "^2.1.0",
    "@handijit/utils": "^2.0.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.3.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.9.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "^5.1.0",
    "electron": "^45.2.3",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "jsdom": "^31.0.0",
    "prettier": "^3.9.10",
    "publint": "^0.3.25",
    "react": "^19.3.1",
    "react-bootstrap-icons": "^1.11.6",
    "react-dom": "^19.3.1",
    "rollup": "^4.68.2",
    "rollup-plugin-dts": "^6.5.1",
    "tslib": "^2.9.1",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0",
    "zod": "^4.6.7"
  }
}
